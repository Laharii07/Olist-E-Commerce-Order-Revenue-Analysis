-- Question 53 Create materialized view for monthly revenue summary.--
CREATE VIEW vw_monthly_revenue
WITH SCHEMABINDING
AS
SELECT 
    YEAR(o.order_purchase_timestamp) AS yr,
    MONTH(o.order_purchase_timestamp) AS mn,
    SUM(oi.price + oi.freight_value) AS total_revenue,
    COUNT_BIG(*) AS row_count
FROM dbo.orders o
JOIN dbo.order_items oi 
    ON o.order_id = oi.order_id
GROUP BY 
    YEAR(o.order_purchase_timestamp),
    MONTH(o.order_purchase_timestamp);
GO

CREATE UNIQUE CLUSTERED INDEX idx_vw_monthly_revenue
ON vw_monthly_revenue(yr, mn);

-- Question 54 Compare CTE vs Subquery performance for top customer query.--
WITH customer_spending AS (
    SELECT 
        c.customer_unique_id,
        SUM(oi.price + oi.freight_value) AS total_spent
    FROM orders o
    JOIN customers c ON o.customer_id = c.customer_id
    JOIN order_items oi ON o.order_id = oi.order_id
    GROUP BY c.customer_unique_id
)
SELECT *
FROM customer_spending
WHERE total_spent > (
    SELECT AVG(total_spent) FROM customer_spending
);


SELECT *
FROM (
