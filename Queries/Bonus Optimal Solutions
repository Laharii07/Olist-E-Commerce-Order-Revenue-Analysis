-- Question 55 Optimize query calculating cohort retention.--

WITH base_data AS (
    SELECT 
        c.customer_unique_id,
        DATEFROMPARTS(YEAR(o.order_purchase_timestamp), 
                      MONTH(o.order_purchase_timestamp), 1) AS order_month,
        MIN(DATEFROMPARTS(YEAR(o.order_purchase_timestamp), 
                          MONTH(o.order_purchase_timestamp), 1)) 
            OVER (PARTITION BY c.customer_unique_id) AS cohort_month
    FROM orders o
    JOIN customers c ON o.customer_id = c.customer_id
),
cohort_counts AS (
    SELECT 
        cohort_month,
        order_month,
        COUNT(DISTINCT customer_unique_id) AS customers
    FROM base_data
    GROUP BY cohort_month, order_month
),
cohort_size AS (
    SELECT 
        cohort_month,
        COUNT(DISTINCT customer_unique_id) AS total_customers
    FROM base_data
    WHERE cohort_month = order_month
    GROUP BY cohort_month
)

SELECT 
    cc.cohort_month,
    cc.order_month,
    cc.customers,
    cs.total_customers,
    cc.customers * 100.0 / cs.total_customers AS retention_rate
FROM cohort_counts cc
JOIN cohort_size cs 
    ON cc.cohort_month = cs.cohort_month
ORDER BY cc.cohort_month, cc.order_month;
