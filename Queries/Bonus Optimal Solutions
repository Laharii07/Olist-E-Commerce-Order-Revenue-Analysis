-- Question 51 Identify slow-running query and suggest index strategy.--
SELECT 
    c.customer_state,
    SUM(oi.price + oi.freight_value) AS revenue
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
JOIN order_items oi ON o.order_id = oi.order_id
GROUP BY c.customer_state;

-- Orders
CREATE NONCLUSTERED INDEX idx_orders_customer 
ON orders(customer_id, order_id);

-- Order Items
CREATE NONCLUSTERED INDEX idx_orderitems_order 
ON order_items(order_id)
INCLUDE (price, freight_value);

-- Customers
CREATE NONCLUSTERED INDEX idx_customers_state 
ON customers(customer_id, customer_state);

